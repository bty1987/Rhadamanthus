<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
    "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<constant name="struts.enable.DynamicMethodInvocation" value="false" />
	<constant name="struts.devMode" value="false" />
	<constant name="struts.action.extension" value="do" />
	<constant name="struts.objectFactory" value="spring" />
	<constant name="struts.configuration.xml.reload" value="true" />
	<constant name="struts.custom.i18n.resources" value="messageResource" />

	<constant name="struts.serve.static.browserCache" value="false" />
	<!-- 指定允许上传的文件最大字节数。默认值是2097152(2M) -->
	<constant name="struts.multipart.maxSize" value="102400000000000" />
	<!-- 设置上传文件的临时文件夹,默认使用javax.servlet.context.tempdir -->
	<constant name="struts.multipart.saveDir " value="/upload/tmp" />

	<package name="base" extends="json-default,struts-default">
		<interceptors>
			<interceptor-stack name="accessItctStack">
				<interceptor-ref name="defaultStack">
					<param name="exception.logEnabled">true</param>
					<param name="exception.logLevel">ERROR</param>
				</interceptor-ref>
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="accessItctStack" />
			<global-results>
				<result name="error">operateError.do</result>
				<result name="login">login.do</result>
			</global-results>
		<global-exception-mappings>
			<exception-mapping result="error" exception="java.lang.Exception">	</exception-mapping>
		</global-exception-mappings>
	</package>

	<package name="import" extends="json-default,struts-default">
		<!-- 这里可以设置一些全局的返回值映射关系等 -->

		<interceptors>
			<interceptor name="uploadInterceptor" class="com.fanglin.interceptor.UploadInterceptor" />
			<interceptor-stack name="accessItctStack">
				<interceptor-ref name="uploadInterceptor">
					<!-- 配置允许上传的文件类型，多个用","分隔 -->
					<param name="allowedTypes"> application/octet-stream </param>
					<!--配置允许上传文件的扩展名,如果有多个用","隔开 -->
					<param name="fileUpload.allowedExtensions">rar,7z,tar,gz,dwt,doc,txt,xls,docx,xlsx</param>
					<!-- 配置允许上传的文件大小，单位字节5M -->
					<param name="maximumSize">5242880</param>
				</interceptor-ref>
				<interceptor-ref name="defaultStack">
					<param name="exception.logEnabled">true</param>
					<param name="exception.logLevel">ERROR</param>
				</interceptor-ref>
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="accessItctStack" />
		<global-results>
			<result name="error" type="chain">operateError.do</result>
			<result name="login" type="chain">login.do</result>
		</global-results>
		<global-exception-mappings>
			<exception-mapping result="error" exception="java.lang.Exception">
			</exception-mapping>
		</global-exception-mappings>

	</package>

	<package namespace="/" name="upload" extends="json-default,struts-default">
		<interceptors>
			<interceptor name="uploadInterceptor"
				class="com.fanglin.interceptor.UploadInterceptor" />
			<interceptor-stack name="accessItctStack">
				<interceptor-ref name="defaultStack">
					<param name="exception.logEnabled">true</param>
					<param name="exception.logLevel">ERROR</param>
				</interceptor-ref>
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="accessItctStack" />

		<action name="uploadFileError" method="uploadFileError"
			class="com.fanglin.action.UploadAction">
			<interceptor-ref name="defaultStack" />
			<result name="success" type="json">
				<param name="ignoreHierarchy">false</param>
				<param name="contentType">text/html</param>
			</result>
		</action>

		<action name="uploadImg" method="uploadImg"
			class="com.fanglin.action.UploadAction">
			<interceptor-ref name="uploadInterceptor">
				<!-- 配置允许上传的文件类型，多个用","分隔 -->
				<param name="allowedTypes">image/bmp,image/png,image/jpg,image/jpeg,application/octet-stream</param>
				<!--配置允许上传文件的扩展名,如果有多个用","隔开 -->
				<param name="fileUpload.allowedExtensions">jpg,jpeg,png,bmp</param>
				<!-- 配置允许上传的文件大小，单位字节 5M -->
				<param name="maximumSize">5242880</param>
			</interceptor-ref>
			<interceptor-ref name="defaultStack" />

			<!-- 动态设置Action中的savePath属性的值 -->
			<param name="rootPath">/home/fanglin/</param>
			<param name="savePath">/upload/Imag/</param>
			<result name="input" type="chain">uploadFileError</result>
			<result name="success" type="json">
				<param name="ignoreHierarchy">false</param>
				<param name="contentType">text/html</param>
			</result>
			<result name="error" type="chain">uploadFileError</result>
		</action>

		<action name="uploadOther" method="uploadOther"
			class="com.fanglin.action.UploadAction">
			<interceptor-ref name="uploadInterceptor">
				<!-- 配置允许上传的文件类型，多个用","分隔 -->
				<param name="allowedTypes"> application/octet-stream,application/msword,application/x-xls,application/pdf</param>
				<!--配置允许上传文件的扩展名,如果有多个用","隔开 -->
				<param name="fileUpload.allowedExtensions">rar,7z,tar,gz,dwt,doc,txt,xls,docx,xlsx</param>
				<!-- 配置允许上传的文件大小，单位字节5M -->
				<param name="maximumSize">5242880</param>
			</interceptor-ref>
			<interceptor-ref name="defaultStack" />

			<!-- 动态设置Action中的savePath属性的值 -->
			<param name="savePath">/upload/Other/</param>

			<result name="input" type="chain">uploadFileError</result>
			<result name="success" type="json">
				<param name="ignoreHierarchy">false</param>
				<param name="contentType">text/html</param>
			</result>
			<result name="error" type="chain">uploadFileError</result>
		</action>

		<action name="showImg" method="showImg" class="com.fanglin.action.ImagAction">
			<result name="success" type="redirect">${zooFileDisplayPath}</result>
		</action>


		<action name="downloadFile" method="downloadFile"
			class="com.fanglin.action.DownloadFileAction">
			<result name="success" type="stream">
			 	<param name="contentType">text/html</param>  
			 	<param name="contentDisposition">attachment;fileName="${fileName}"</param>
    			<param name="inputName">downloadFileInputStream</param>  
				
			</result>
		</action>

	</package>


</struts>
